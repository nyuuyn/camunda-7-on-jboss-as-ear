<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>camunda-7-on-jboss-as-ear</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>camunda-engine</artifactId>
  <packaging>war</packaging>

  <name>camunda-engine</name>
  <description>
    The Camunda process engine itself, and nothing else: bootstrap
    (camunda.cfg.xml), the container-managed Job Executor
    (ManagedJobExecutor), and the embedded REST API (CamundaRestApplication)
    that process-application talks to over HTTP instead of sharing a
    classloader with it. No process definitions or business logic live here.
  </description>

  <properties>
    <junit-jupiter.version>5.12.2</junit-jupiter.version>
    <h2.version>2.2.224</h2.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>javax</groupId>
      <artifactId>javaee-api</artifactId>
    </dependency>
    <!-- Bundled into ear/lib/ by the ear module - compiled against here,
         supplied at runtime via the EAR's shared classpath. -->
    <dependency>
      <groupId>org.camunda.bpm</groupId>
      <artifactId>camunda-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.camunda.bpm</groupId>
      <artifactId>camunda-engine-rest-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.jaxrs</groupId>
      <artifactId>jackson-jaxrs-json-provider</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Bundled into WEB-INF/lib (runtime scope, not test) so
         org.h2.jdbcx.JdbcDataSource is visible to this WAR's own
         classloader - CamundaEngineBootstrap's @DataSourceDefinition needs
         to load it directly (see that class's javadoc), and doing it this
         way means no server module install is needed at all for the demo
         datasource. Also used by IdentityBootstrapConcurrencyTest, which
         runs the real engine
         (ProcessEngineConfiguration.createStandaloneInMemProcessEngineConfiguration())
         against an in-memory H2 database instead of JBoss's JTA datasource,
         to exercise IdentityBootstrap's unique-constraint race handling
         against a real database without needing a container. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>camunda-engine</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <failOnMissingWebXml>true</failOnMissingWebXml>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
