<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>camunda-demo-web</display-name>

  <!-- com.example.camunda.CamundaEngineBootstrapListener is registered via
       @WebListener, not declared here - see that class for what it does. -->

  <!--
    Required by camunda-engine-rest for the External Task REST API's
    long-polling fetchAndLock: without it,
    FetchAndLockContextListener.getFetchAndLockHandler() returns null and
    every POST /external-task/fetchAndLock throws a server-side NPE
    (found by actually deploying to a container and reading the resulting
    500 errors - not documented anywhere I saw while researching the REST
    embedding setup).
  -->
  <listener>
    <listener-class>org.camunda.bpm.engine.rest.impl.FetchAndLockContextListener</listener-class>
  </listener>

</web-app>