<?xml version="1.0" encoding="UTF-8"?>
<!--
  ear-subdeployments-isolated=true enforces process-application's REST-only
  decoupling from camunda-engine at the classloader level. See ADR-3 and
  docs/arc42/08-crosscutting-concepts.md §8.5.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
  <ear-subdeployments-isolated>true</ear-subdeployments-isolated>
  <sub-deployment name="camunda-engine.war">
    <exclusions>
      <!-- WildFly's built-in JSON-B provider otherwise wins over Jackson and
           breaks date parsing - see arc42 §8.4 and §11.1. -->
      <module name="org.jboss.resteasy.resteasy-json-binding-provider"/>
    </exclusions>
  </sub-deployment>
  <sub-deployment name="camunda-web-ui.war">
    <exclusions>
      <!-- Same JSON-B-vs-Jackson conflict as camunda-engine.war above. -->
      <module name="org.jboss.resteasy.resteasy-json-binding-provider"/>
    </exclusions>
  </sub-deployment>
</jboss-deployment-structure>
