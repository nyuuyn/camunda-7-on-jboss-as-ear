<?xml version="1.0" encoding="UTF-8"?>
<!--
  ear-subdeployments-isolated=true: process-application is meant to be
  genuinely decoupled from camunda-engine - it only ever talks to it over
  HTTP - so there's no need for it to share a classloader with it. lib/
  (camunda-engine, camunda-external-task-client, etc.) stays visible to
  all subdeployments regardless of this setting; isolation only affects
  whether the subdeployments can see each other's own classes directly,
  which neither needs to.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
  <ear-subdeployments-isolated>true</ear-subdeployments-isolated>
  <sub-deployment name="camunda-engine.war">
    <exclusions>
      <!-- WildFly's built-in RESTEasy JSON-B (Yasson) provider was
           apparently winning over our bundled Jackson for
           application/json responses: JSON-B's default temporal format
           is ISO_ZONED_DATE_TIME, which is exactly the
           "...Z[UTC]"-suffixed output that broke the External Task
           Client's date parsing (found by deploying and reading the raw
           fetchAndLock response). Excluding it forces RESTEasy to use
           the Jackson provider camunda-engine-rest-core actually expects. -->
      <module name="org.jboss.resteasy.resteasy-json-binding-provider"/>
    </exclusions>
  </sub-deployment>
</jboss-deployment-structure>
