<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>camunda-7-on-jboss-as-ear</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>camunda-7-on-jboss-as-ear</name>
  <description>
    Demonstrates deploying Camunda 7 as a Java EE EAR on JBoss EAP with no
    Camunda subsystem installed, and with the process application fully
    decoupled from the engine: camunda-engine hosts the bootstrapped engine
    and its embedded REST API; process-application deploys the demo BPMN to
    it over REST at startup and handles its only task over the External
    Task REST API. process-application has no compile-time dependency on
    camunda-engine. camunda-web-ui (Cockpit/Tasklist/Admin, overlaying
    Camunda's prebuilt webapp WAR) is a separate subdeployment too, but
    shares the engine via ear/lib/ rather than REST, since those UIs need
    direct Java-API access to the running ProcessEngine. The engine's Job
    Executor thread pool comes from JBoss's built-in ManagedExecutorService
    (java:jboss/ee/concurrency/executor/default) instead of a thread pool
    it manages itself. The datasource is declared inside the EAR too, via
    @DataSourceDefinition on CamundaEngineBootstrap, with its JDBC driver
    bundled as an ordinary runtime dependency - no server-side setup is
    required at all.
  </description>

  <modules>
    <module>camunda-engine</module>
    <module>process-application</module>
    <module>camunda-web-ui</module>
    <module>ear</module>
    <module>integration-test</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>

    <!-- Last Camunda 7 line supporting the javax namespace (Jakarta EE 8),
         matching JBoss EAP 7.4 / WildFly <= 26. Do not bump to a WildFly
         27+/Jakarta EE 10 target without switching to the *-jakarta artifacts.
         camunda-engine/camunda-engine-rest-core/camunda-external-task-client
         (the non-"-jakarta"-suffixed artifacts) still compile against
         javax.* through 7.23.0 - confirmed by inspecting the compiled
         classes, not just release notes. -->
    <camunda.version>7.23.0</camunda.version>
    <javaee-api.version>7.0</javaee-api.version>
    <!-- Matches the jackson-databind version camunda-engine-rest-core
         resolves to transitively - keep these aligned to avoid mixed
         Jackson minor versions on the classpath. -->
    <jackson-jaxrs-json-provider.version>2.14.1</jackson-jaxrs-json-provider.version>
    <!-- camunda-external-task-client's built-in XML DataFormatProvider
         (used for application/xml process variables) references
         jakarta.xml.bind.* internally as of 7.23.0, even though the
         client's own artifact otherwise stays on javax.* - a narrow,
         Camunda-side exception to this project's javax.* target, not a
         general jakarta.* migration. JAXB itself has been absent from the
         JDK since 11 either way, so this has to be supplied regardless of
         Java version. Versions pinned to match exactly what
         camunda-external-task-client:7.23.0 itself depends on
         (org.camunda.bpm:camunda-parent:7.23.0's version.jakarta.xml.bind-api
         / version.xml.jaxb-impl4 properties) rather than guessing a
         compatible pair. -->
    <jakarta.xml.bind-api.version>4.0.2</jakarta.xml.bind-api.version>
    <jaxb-impl.version>4.0.5</jaxb-impl.version>

    <maven-ejb-plugin.version>3.2.1</maven-ejb-plugin.version>
    <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
    <maven-ear-plugin.version>3.3.0</maven-ear-plugin.version>
  </properties>

  <!--
    No scope is fixed here on purpose: the ear module needs these at
    "compile" scope (so they get bundled into ear/lib/), while camunda-engine
    and process-application only need them at "provided" scope (compiled
    against, supplied at runtime via ear/lib/). Each module declares its
    own scope explicitly.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-engine</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <!-- camunda-engine-rest with classifier "classes" is nearly empty
           (just a MANIFEST.MF) - camunda-engine-rest-core (no classifier)
           is where CamundaRestResources and the actual JAX-RS resource
           implementations live. -->
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-engine-rest-core</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <!-- Cockpit/Tasklist/Admin, overlaid into camunda-web-ui.war. Its own
           WEB-INF/lib (camunda-engine-rest-core, Jackson, etc.) ships
           self-contained inside this WAR artifact - camunda-engine.jar
           itself is deliberately NOT in there (confirmed by inspecting the
           artifact directly), so it resolves the shared ProcessEngine from
           ear/lib/ the same way camunda-engine.war's own bootstrap does,
           rather than bundling a second, disconnected engine instance. -->
      <dependency>
        <groupId>org.camunda.bpm.webapp</groupId>
        <artifactId>camunda-webapp</artifactId>
        <version>${camunda.version}</version>
        <type>war</type>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.jaxrs</groupId>
        <artifactId>jackson-jaxrs-json-provider</artifactId>
        <version>${jackson-jaxrs-json-provider.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-external-task-client</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.xml.bind</groupId>
        <artifactId>jakarta.xml.bind-api</artifactId>
        <version>${jakarta.xml.bind-api.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sun.xml.bind</groupId>
        <artifactId>jaxb-impl</artifactId>
        <version>${jaxb-impl.version}</version>
      </dependency>

      <!-- Provided by JBoss EAP itself -->
      <dependency>
        <groupId>javax</groupId>
        <artifactId>javaee-api</artifactId>
        <version>${javaee-api.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ejb-plugin</artifactId>
          <version>${maven-ejb-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>${maven-war-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ear-plugin</artifactId>
          <version>${maven-ear-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
