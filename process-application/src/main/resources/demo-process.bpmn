<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="demo-definitions"
             targetNamespace="http://example.com/camunda/demo">

  <!-- historyTimeToLive is required as of Camunda 7.23 (ENGINE-12018) -
       deployment is rejected without it, whereas 7.19 didn't enforce this.
       180 days is an arbitrary demo value; production processes should
       set this deliberately per their own retention requirements. -->
  <process id="demoProcess" name="Demo Process" isExecutable="true" camunda:historyTimeToLive="180">
    <startEvent id="start" name="Start" />

    <sequenceFlow id="flow1" sourceRef="start" targetRef="externalTask" />

    <!-- No delegate class, no engine-side code at all: this task is
         fetched, locked, executed and completed entirely over REST by
         whatever subscribes to topic "demo-topic" - see
         DemoExternalTaskWorker.

         asyncBefore=true makes the engine create a Job to transition into
         this task, run by ManagedJobExecutor on JBoss's managed thread
         pool - without it, this process never exercises the Job Executor
         at all, only the External Task Client path. -->
    <serviceTask id="externalTask" name="External Demo Task"
                 camunda:type="external"
                 camunda:topic="demo-topic"
                 camunda:asyncBefore="true" />

    <sequenceFlow id="flow2" sourceRef="externalTask" targetRef="end" />

    <endEvent id="end" name="End" />
  </process>
</definitions>
