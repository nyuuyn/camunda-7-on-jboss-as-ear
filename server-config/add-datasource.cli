## JBoss CLI script: installs the H2 JDBC driver as a server module and
## registers the "ProcessEngine" datasource that DemoProcessEngineBootstrap
## (process-archive) looks up via JNDI at java:jboss/datasources/ProcessEngine.
##
## This is the one piece of this project that lives on the server instead
## of inside the EAR - everything else (engine jars, process engine
## bootstrap, job executor thread pool) is bundled in the EAR itself. See
## the top-level README for why the datasource is handled here.
##
## Demo-only: H2 is fine for trying this out. For anything real, replace
## this with a proper XA datasource (Oracle/Postgres/etc.) so the process
## engine's database work fully participates in JTA two-phase commit
## alongside your other resources.
##
## Usage:
##   1. Download h2-2.2.224.jar (or adjust H2_JAR_PATH/H2_VERSION below).
##   2. $JBOSS_HOME/bin/jboss-cli.sh --connect --file=add-datasource.cli

module add --name=com.h2database.h2 \
    --resources=H2_JAR_PATH/h2-H2_VERSION.jar \
    --dependencies=javax.api,javax.transaction.api

/subsystem=datasources/jdbc-driver=h2:add( \
    driver-name=h2, \
    driver-module-name=com.h2database.h2, \
    driver-class-name=org.h2.Driver)

data-source add \
    --name=ProcessEngine \
    --jndi-name=java:jboss/datasources/ProcessEngine \
    --driver-name=h2 \
    --connection-url=jdbc:h2:./camunda-h2-database/process-engine;AUTO_SERVER=TRUE \
    --user-name=sa \
    --password=sa \
    --use-ccm=true \
    --max-pool-size=5 \
    --blocking-timeout-wait-millis=5000 \
    --enabled=true

:reload